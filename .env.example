# Основной режим обращается к FastAPI на том же адресе
VITE_DEMO_MODE=false
# Для отдельного сервера укажите его адрес
VITE_API_BASE=
# Относительный путь сохраняет работу в подкаталоге
VITE_BASE_PATH=./

# Данные предприятия для сервера FastAPI
SEVERNAYA_SOURCE_DATA_DIR=bundled
SEVERNAYA_CLIENT_DATA_DIR=backend/client_data
